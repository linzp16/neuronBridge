{
  "schema_version": 1,
  "kind": "custom_learning_rule",
  "variant_id": 20003,
  "implementation_name": "CustomPairStdpV1",
  "canonical_name": "CustomPairStdpV1",
  "extends": {"base_class": "CustomLearningRuleModel", "contract_version": 1},
  "api": {"visibility": "experimental"},
  "backends": {"legacy_cpu": true, "dense_gpu": true},
  "dense_factory_model_id": 6,
  "catalog_category": "pair_based",
  "equations": "dpre_trace/dt = -pre_trace / ltp_tau : 1\ndpost_trace/dt = -post_trace / ltd_tau : 1",
  "parameters": {
    "max_ltp": {"api_name": "Max_LTP", "default": 0.92},
    "ltp_tau": {"api_name": "LTP_tau", "default": 16.8, "constraints": {"exclusive_min": 0.0}},
    "max_ltd": {"api_name": "Max_LTD", "default": 0.53},
    "ltd_tau": {"api_name": "LTD_tau", "default": 33.1, "constraints": {"exclusive_min": 0.0}}
  },
  "events": {
    "on_pre": ["pre_trace += 1", "weight += -max_ltd * post_trace"],
    "on_post": ["post_trace += 1", "weight += max_ltp * pre_trace"]
  },
  "integration": {"method": "exact_exponential", "time": "arrival_ticks_times_base_dt"},
  "runtime": {
    "dense": {
      "capability": "pair_stdp_v1",
      "roles": {
        "pre_state": "pre_trace",
        "post_state": "post_trace",
        "ltp_amplitude_parameter": "max_ltp",
        "ltd_amplitude_parameter": "max_ltd",
        "ltp_tau_parameter": "ltp_tau",
        "ltd_tau_parameter": "ltd_tau"
      }
    }
  },
  "reference": "STDP"
}
